// Incredible Treasures Prisma Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  image       String?
  displayOrder Int      @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  tagline        String?
  description    String
  basePrice      Float
  hsnCode        String           @default("49090000") // Printing HSN Code
  categoryId     String
  category       Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  minQuantity    Int              @default(100)
  estimatedDays  String           @default("2-3 Business Days")
  images         String           // JSON stringified array of image URLs
  featured       Boolean          @default(false)
  rating         Float            @default(4.9)
  reviewCount    Int              @default(128)
  variants       ProductVariant[]
  volumeTiers    VolumeTier[]
  templates      Template[]
  orderItems     OrderItem[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String   // e.g. "350 GSM Royal Matte"
  paperType     String   // e.g. "Royal Matte", "Velvet Touch", "Recycled Kraft"
  thicknessGsm  Int      @default(350)
  finish        String   // e.g. "Silk Matte", "Gloss Lamination", "Spot UV + Gold Foil"
  cornerStyle   String   @default("Square") // "Square" or "Rounded"
  priceModifier Float    @default(0.0) // Additional cost per unit
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model VolumeTier {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity        Int      // 100, 250, 500, 1000, 2500, 5000
  unitPrice       Float    // Price per piece at this tier
  discountPercent Int      @default(0) // Savings badge, e.g. 35%
  isPopular       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([productId, quantity])
}

model Template {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name             String
  slug             String   @unique
  industry         String   // "Corporate", "Doctors", "Lawyers", "Tech", "Real Estate", "Luxury"
  previewFront     String
  previewBack      String?
  canvasDataFront  String   // JSON string of Fabric.js canvas state
  canvasDataBack   String?  // JSON string of Fabric.js canvas state
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model User {
  id           String        @id @default(cuid())
  supabaseId   String?       @unique
  email        String        @unique
  passwordHash String?
  name         String?
  phone        String?
  companyName  String?
  gstin        String?
  role         String        @default("CUSTOMER") // "CUSTOMER", "STAFF", "SUPER_ADMIN"
  orders       Order[]
  savedDesigns SavedDesign[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model SavedDesign {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId       String?  // Guest or anonymous session token
  name            String   @default("Untitled Luxury Design")
  productSlug     String   @default("visiting-cards")
  substrateId     String   @default("pvc-regular-glossy")
  orientation     String   @default("horizontal") // "horizontal" | "vertical"
  cornerStyle     String   @default("square")     // "square" | "rounded"
  backgroundColor String   @default("#FFFFFF")
  gildedEdge      Boolean  @default(false)
  cardTexture     String   @default("smooth")
  
  // Serialized Canvas Elements (JSON string of CanvasElement[])
  frontElements   String   // JSON string
  backElements    String   // JSON string

  // Background Artwork & Settings
  frontBgImage    String?
  backBgImage     String?
  frontBgOpacity  Float    @default(1.0)
  backBgOpacity   Float    @default(1.0)
  frontBgFit      String   @default("cover")
  backBgFit       String   @default("cover")

  // High-fidelity compact preview thumbnails (DataURL or image path)
  previewFront    String?
  previewBack     String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([sessionId])
}

model Order {
  id                          String      @id @default(cuid())
  orderNumber                 String      @unique // e.g. "IT-PRINT-017378"
  userId                      String?
  user                        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  source                      String      @default("studio")
  customerName                String
  customerEmail               String
  customerPhone               String
  shippingAddress             String
  city                        String
  state                       String
  pincode                     String
  isB2B                       Boolean     @default(false)
  companyName                 String?
  gstin                       String?
  subtotal                    Float
  taxAmount                   Float       // 18% GST (CGST+SGST or IGST)
  cgstAmount                  Float       @default(0.0)
  sgstAmount                  Float       @default(0.0)
  igstAmount                  Float       @default(0.0)
  shippingFee                 Float       @default(0.0)
  shippingTier                String      @default("standard")
  couponCode                  String?
  discountAmount              Float       @default(0.0)
  totalAmount                 Float
  status                      String      @default("ORDER_CONFIRMED") // ORDER_CONFIRMED, PRE_FLIGHT_VERIFIED, IN_PRODUCTION, QUALITY_FINISHING, DISPATCHED, DELIVERED
  statusLabel                 String?
  paymentStatus               String      @default("PAID_ADVANCE") // PAID_ADVANCE, AWAITING_PAYMENT, PO_NET30
  paymentMethod               String      @default("card")
  razorpayOrderId             String?
  razorpayPaymentId           String?
  trackingNumber              String?
  awbNumber                   String?
  courierPartner              String?     @default("BlueDart Apex Air")
  courierTrackingUrl          String?
  destinationCity             String?
  guaranteedDeliveryFormatted String?
  items                       OrderItem[]
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product? @relation(fields: [productId], references: [id])
  productName       String
  categoryName      String?
  variantName       String?
  quantity          Int
  unitPrice         Float
  totalPrice        Float
  specsJson         String?  // JSON string of selected paper, finish, corners
  customDesignFront String?  // High-res preview / storage URL
  customDesignBack  String?  // High-res preview / storage URL
  printReadyPdfUrl  String?  // 300 DPI vector PDF URL for print press
  isGstIncluded     Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
